# Environment files — never commit real secrets. Only *.env.example files are tracked.
.env
.env.local
.env.*.local
*.env
!*.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/.turbo/
node_modules/

# Evaluation reports (generated by evaluation.runner — regenerate locally, don't commit)
backend/evaluation/reports/*.json

# Docker
*.pid

# IDE / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
